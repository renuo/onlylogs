<style>
    .grid {
        display: grid;
        grid-template-rows: 38px 1fr;
        height: 100vh;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, Courier, monospace;
        font-size: 0.8rem;
    }

    .grid-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0 0.65rem;
        background-color: #f3f5f9;
        border-bottom: 1px solid #dde3ec;
        color: #58626f;
    }

    .log-file-dropdown select {
        font: inherit;
        padding: 0.2rem 0.4rem;
        border: 1px solid #b9c4d3;
        border-radius: 3px;
        background-color: #fff;
        color: #12171f;
    }

    .download-link {
        color: #1a4fc4;
        text-decoration: none;
        padding: 0.2rem 0.45rem;
        border: 1px solid #9dbcf7;
        border-radius: 3px;
        background-color: #e8f0fe;
    }

    .download-link:hover {
        background-color: #d7e5fd;
    }
</style>
<div class="grid">
  <div class="grid-header">
    <% if @available_log_files.any? %>
      <%= form_with url: root_path, method: :get, local: true, class: "log-file-dropdown", data: { controller: "auto-submit" } do %>
        <select id="log_file_path" name="log_file_path" data-action="change->auto-submit#submit">
          <% @available_log_files.each do |file| %>
            <option value="<%= Onlylogs::SecureFilePath.encrypt(file) %>" <%= "selected" if file.to_s == @log_file_path.to_s %>>
              <%= log_file_label(file) %>
            </option>
          <% end %>
        </select>
      <% end %>
      <% if @log_file_path %>
        <%= link_to "Download", download_log_path(log_file_path: Onlylogs::SecureFilePath.encrypt(@log_file_path)), class: "download-link" %>
      <% end %>
    <% end %>
  </div>
  <%= render partial: "onlylogs/shared/log_container", locals: { log_file_path: @log_file_path } %>
</div>
