<%# locals: (log_file_path:, live_enabled: true) %>
<script nonce="<%= request.content_security_policy_nonce %>"
        src="<%= asset_path('onlylogs/clusterize.js') %>"></script>
<link rel="stylesheet" href="<%= asset_path('onlylogs/clusterize.css') %>" />
<%= render "onlylogs/shared/log_container_styles" %>

<%
    autoscroll = local_assigns[:autoscroll] != false
    filter = local_assigns[:filter] || ""
    regexp_mode = local_assigns[:regexp_mode] == true
    case_insensitive = local_assigns[:case_insensitive] == true
    # A file nothing writes to any more (no drain attached, a rotated log) has nothing
    # to follow, so live mode is not offered at all and the viewer opens in search.
    mode = live_enabled ? (local_assigns[:mode] || "live") : "static"
    file_size = File.size(log_file_path)
    start_position = local_assigns[:start_position]
    end_position = local_assigns[:end_position]
    byte_offset = request.params[:byte_offset]

    raise SecurityError, "File path not allowed" unless Onlylogs.file_path_permitted?(log_file_path)

    encrypted_log_file_path = Onlylogs::SecureFilePath.encrypt(log_file_path)

    shortcut_modifier = request.user_agent.to_s.match?(/Macintosh|iPhone|iPad/) ? "control" : "alt"
    shortcut_modifier_label = shortcut_modifier == "control" ? "⌃ Control" : "Alt"
%>

<div data-controller="log-streamer text-selection keyboard-shortcuts log-cursor match-highlight queries"
     data-queries-log-file-path-value="<%= encrypted_log_file_path %>"
     data-queries-endpoint-value="<%= onlylogs.queries_path %>"
     data-keyboard-shortcuts-modifier-value="<%= shortcut_modifier %>"
     data-log-streamer-file-path-value="<%= encrypted_log_file_path %>"
     <% if start_position.present? %>data-log-streamer-start-position-value="<%= start_position %>"<% end %>
     <% if end_position.present? %>data-log-streamer-end-position-value="<%= end_position %>"<% end %>
     data-log-streamer-filter-value="<%= filter %>"
     data-log-streamer-auto-scroll-value="<%= autoscroll %>"
     data-log-streamer-regexp-mode-value="<%= regexp_mode %>"
     data-log-streamer-case-insensitive-value="<%= case_insensitive %>"
     data-log-streamer-mode-value="<%= mode %>"
     data-log-streamer-live-enabled-value="<%= live_enabled %>"
     data-log-streamer-file-size-value="<%= file_size %>"
     data-action="text-selection:start->log-streamer#pauseForSelection text-selection:search->log-streamer#switchToSearch
                  log-streamer:cleared->log-cursor#reset log-streamer:cleared->text-selection#forgetSelection log-streamer:context-line->log-cursor#placeAt
                  log-streamer:rendering->text-selection#saveSelection log-streamer:rendered->text-selection#restoreSelection
                  log-cursor:move->log-streamer#pauseForSelection log-cursor:select->text-selection#showForSelection
                  log-cursor:search->text-selection#searchSelectedText keyboard-shortcuts:lines->log-cursor#focus
                  log-streamer:context-line->queries#cleared"
     class="onlylogs-log-container" >
    <div data-log-streamer-target="logLines" data-text-selection-target="logLines" data-log-cursor-target="lines" data-match-highlight-target="lines"
         data-action="keydown->log-cursor#navigate mousedown->log-cursor#pointAt focusin->log-cursor#activate"
         id="scrollArea" class="onlylogs-log-lines clusterize-scroll">
      <div id="contentArea" class="clusterize-content">
      </div>
    </div>

    <%# Search with an empty query would stream the entire file, so it is not run
        at all until something is typed. This says so instead of looking idle. %>
    <div class="onlylogs-search-placeholder" data-log-streamer-target="searchPlaceholder" hidden>
      <p class="onlylogs-search-placeholder__title">Nothing to search for yet</p>
      <p class="onlylogs-search-placeholder__hint">
        <% if live_enabled %>
          Type a query to search this file, or switch to Live to follow it as it is written.
        <% else %>
          Type a query to search this file.
        <% end %>
      </p>
    </div>

    <button type="button"
            data-text-selection-target="button"
            class="onlylogs-context-menu hidden-button"
            data-action="click->text-selection#searchSelectedText"
            title="Search selected text (Enter)">
      🔍 Search <kbd>↵</kbd>
    </button>

    <div class="onlylogs-log-toolbar">
      <div class="onlylogs-toolbar-row onlylogs-toolbar-row--controls">
        <% if live_enabled %>
        <div class="onlylogs-mode-switch" role="group" aria-label="Log mode">
          <button type="button"
                  class="onlylogs-mode-switch__button"
                  data-onlylogs-mode-button="live"
                  data-onlylogs-shortcut="l"
                  data-log-streamer-target="liveButton"
                  data-action="click->log-streamer#switchToLive"
                  aria-pressed="<%= mode == "live" %>"
                  title="Follow the file as it is written">
            <span>▶ Live</span>
          </button>
          <button type="button"
                  class="onlylogs-mode-switch__button"
                  data-onlylogs-mode-button="static"
                  data-onlylogs-shortcut="s"
                  data-log-streamer-target="searchButton"
                  data-action="click->log-streamer#switchToSearch"
                  aria-pressed="<%= mode != "live" %>"
                  title="Search what is already in the file">
            <span>🔍 Search</span>
          </button>
        </div>
        <% end %>
        <div class="onlylogs-query">
          <label class="toolbar-label" for="onlylogs-filter">
            <span data-onlylogs-mode="live">Follow:</span>
            <span data-onlylogs-mode="static">Query:</span>
          </label>
          <div class="saved-searches" data-queries-target="box" data-action="keydown->queries#navigate">
            <div class="filter-input-wrapper" data-onlylogs-shortcut="q">
              <input type="text"
                     id="onlylogs-filter"
                     name="filter"
                     value="<%= filter %>"
                     placeholder="<%= mode == "live" ? "follow lines matching…" : "search the whole file…" %>"
                     spellcheck="false"
                     autocomplete="off"
                     data-log-streamer-target="filterInput"
                     data-text-selection-target="filterInput"
                     data-keyboard-shortcuts-target="filterInput"
                     data-match-highlight-target="filterInput"
                     data-action="input->log-streamer#applyFilter input->queries#refresh keydown.enter->log-cursor#focus keydown.esc->log-cursor#focus">
              <button type="button"
                      data-action="click->log-streamer#clearFilter click->queries#cleared"
                      data-onlylogs-shortcut="x"
                      class="filter-input-button clear-filter-button"
                      aria-label="Clear the query"
                      title="Clear the query">
                <svg width="10" height="10" viewBox="0 0 10 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 2l6 6M8 2l-6 6"/></svg>
              </button>
              <button type="button"
                      class="filter-input-button saved-searches__toggle"
                      data-queries-target="toggle"
                      data-onlylogs-shortcut="v"
                      data-action="queries#toggle"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-controls="onlylogs-saved-searches-panel"
                      aria-label="Saved searches"
                      title="Saved searches">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1" fill="currentColor"/><circle cx="4.5" cy="12" r="1" fill="currentColor"/><circle cx="4.5" cy="18" r="1" fill="currentColor"/></svg>
                <span class="saved-searches__count" data-queries-target="count"></span>
              </button>
              <button type="button"
                      class="filter-input-button saved-searches__star"
                      data-queries-target="star"
                      data-onlylogs-shortcut="f"
                      data-action="queries#toggleSave"
                      aria-haspopup="true"
                      aria-expanded="false"
                      aria-controls="onlylogs-save-search-panel"
                      disabled>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>
              </button>
            </div>

            <div id="onlylogs-saved-searches-panel" class="saved-searches__panel" data-queries-target="panel" hidden>
              <div class="saved-searches__header">
                <span class="saved-searches__title">Saved searches</span>
                <span class="saved-searches__keys">↑↓ move · ↵ apply · esc</span>
              </div>
              <ul class="saved-searches__list" data-queries-target="list" aria-label="Saved searches"></ul>
              <div class="saved-searches__empty" data-queries-target="empty" hidden>
                <strong>No saved searches yet</strong>
                <span>Type a pattern, then click the star in the field to keep it here.</span>
              </div>
              <div class="saved-searches__footer" data-queries-target="footer" hidden>
                <button type="button" class="saved-searches__footer-button" data-action="queries#openSave">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>
                  <span data-queries-target="footerLabel"></span>
                </button>
              </div>
            </div>

            <div id="onlylogs-save-search-panel" class="saved-searches__panel saved-searches__panel--save" data-queries-target="savePanel" hidden>
              <div class="save-search__summary">
                <span class="save-search__title" data-queries-target="saveTitle"></span>
                <div class="save-search__current">
                  <code data-queries-target="saveFilter"></code>
                  <span data-queries-target="saveFlags"></span>
                </div>
              </div>
              <form class="save-search__form" data-action="queries#save">
                <label for="onlylogs-save-search-name">Name</label>
                <div class="save-search__row">
                  <input type="text"
                         id="onlylogs-save-search-name"
                         maxlength="255"
                         placeholder="e.g. Errors"
                         autocomplete="off"
                         data-queries-target="name"
                         data-action="input->queries#nameChanged">
                  <button type="submit" data-queries-target="saveButton" disabled>Save</button>
                </div>
                <p class="save-search__hint" data-queries-target="hint"></p>
              </form>
              <div class="save-search__saved" data-queries-target="savedRow" hidden>
                <span>Already in your saved searches.</span>
                <button type="button" data-action="queries#removeCurrent">Remove</button>
              </div>
            </div>

            <template data-queries-target="rowTemplate">
              <li class="saved-search">
                <button type="button" class="saved-search__apply" data-action="queries#apply">
                  <span class="saved-search__line">
                    <span class="saved-search__name"></span>
                    <svg class="saved-search__check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-label="Current search"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                    <span class="saved-search__edited">edited</span>
                  </span>
                  <span class="saved-search__line">
                    <code class="saved-search__filter"></code>
                    <span class="saved-search__flags"></span>
                  </span>
                </button>
                <input type="text" class="saved-search__rename-input" maxlength="255" autocomplete="off" hidden
                       data-action="keydown->queries#renameKey blur->queries#commitRename">
                <button type="button" class="saved-search__action saved-search__rename" data-action="queries#rename">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/></svg>
                </button>
                <button type="button" class="saved-search__action saved-search__delete" data-action="queries#destroy">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/></svg>
                  <span class="saved-search__delete-label">Delete?</span>
                </button>
              </li>
            </template>
          </div>
        </div>
        <div>
          <label class="toolbar-label" data-onlylogs-shortcut="r">
            <input id="regexpMode" type="checkbox" <%= regexp_mode ? "checked" : "" %> name="regexpMode" data-log-streamer-target="regexpMode" data-text-selection-target="regexpMode" data-match-highlight-target="regexpMode" data-action="change->log-streamer#toggleRegexpMode change->queries#refresh">
            <span>Regexp</span>
          </label>
        </div>
        <div>
          <label class="toolbar-label" data-onlylogs-shortcut="i">
            <input id="caseInsensitive" type="checkbox" <%= case_insensitive ? "checked" : "" %> name="caseInsensitive" data-log-streamer-target="caseInsensitive" data-match-highlight-target="caseInsensitive" data-action="change->log-streamer#toggleCaseInsensitive change->queries#refresh">
            <span>Ignore case</span>
          </label>
        </div>
        <div data-onlylogs-mode="live">
          <label class="toolbar-label" data-onlylogs-shortcut="a">
            <input id="autoscroll" type="checkbox" <%= autoscroll ? "checked" : "" %> name="autoscroll" data-log-streamer-target="autoscroll" data-action="change->log-streamer#toggleAutoScroll">
            <span>Autoscroll</span>
          </label>
        </div>
        <div data-onlylogs-mode="live">
          <button type="button"
                  data-log-streamer-target="searchWholeFileButton"
                  class="search-whole-file-button"
                  data-onlylogs-shortcut="w"
                  data-action="click->log-streamer#searchWholeFile"
                  title="Search this text across the whole file">
            Search whole file →
          </button>
        </div>
        <div class="range-slider-wrapper" data-onlylogs-mode="static" data-onlylogs-shortcut="g">
          <%= render "onlylogs/shared/range_slider",
                     start_name: "start_position",
                     end_name: "end_position",
                     start_value: 0,
                     end_value: file_size,
                     min: 0,
                     max: file_size,
                     step: 1000,
                     label: "Range" %>
          <button type="button"
                  data-action="click->log-streamer#resetRange"
                  class="reset-range-button"
                  data-onlylogs-shortcut="0"
                  title="Reset to full file">
            ↻
          </button>
        </div>
        <div>
          <button type="button"
                  data-log-streamer-target="stopButton"
                  class="stop-search-button hidden-button"
                  data-onlylogs-shortcut="."
                  data-action="click->log-streamer#stopSearch"
                  title="Stop current search">
            ■ Stop
          </button>
        </div>
    </div>

    <div class="onlylogs-toolbar-row onlylogs-toolbar-row--status">
        <span data-log-streamer-target="results" class="results-text" data-onlylogs-shortcut="j"
              data-action="click->log-cursor#focus">Results: 0</span>
        <span data-log-streamer-target="message" class="status-message"></span>
        <div class="onlylogs-toolbar-row__end">
          <% unless Onlylogs.ripgrep_enabled? %>
            <span class="grep-warning" title="Search is slow. Install ripgrep for better performance">⚠️</span>
          <% end %>
          <span class="file-size" title="File size: <%= number_to_human_size(File.size(log_file_path)) %>">
            <%= number_to_human_size(File.size(log_file_path)) %>
          </span>
          <button type="button"
                  data-log-streamer-target="clearButton"
                  class="clear-logs-button"
                  data-onlylogs-shortcut="c"
                  data-action="click->log-streamer#clearLogs"
                  aria-label="Clear all log lines"
                  title="Clear all log lines">
            🗑
          </button>
          <button type="button"
                  class="shortcuts-button"
                  data-action="keyboard-shortcuts#openHelp"
                  aria-label="Keyboard shortcuts"
                  title="Keyboard shortcuts (?) · hold <%= shortcut_modifier_label %> to see the letters">
            ⌨
          </button>
          <span data-log-streamer-target="websocketStatus" class="websocket-status websocket-status--disconnected" title="WebSocket Disconnected">🔴</span>
          <%= render "onlylogs/shared/shortcuts_dialog", modifier_label: shortcut_modifier_label %>
        </div>
    </div>
</div>
