#!/usr/bin/env bash
# Usage: super_grep [--max-matches N] [--regexp] QUERY [FILE]
# Without FILE the input is read from stdin. Every output line is
# "<byte offset of the line>:<line>".
export LC_ALL=C

# Parse arguments
max_matches=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --max-matches)
      max_matches="$2"
      shift 2
      ;;
    --regexp)
      regexp_mode=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

query="$1"
file="$2"

if [ -n "$file" ]; then
  [ -f "$file" ] || exit 1
fi

# Prepare query regex based on mode
if [ "$regexp_mode" = true ]; then
  # Translate \d to [0-9] for grep -E compatibility
  query_regex=$(printf "%s" "$query" | sed 's/\\d/[0-9]/g')
else
  # Escape special characters
  query_regex=$(printf "%s" "$query" | sed -E 's/([][{}()*+?.\\^$|])/\\\1/g')
fi

# Replace spaces with placeholder to avoid sed escaping hell for color regex
placeholder="__COLOR_REGEX__"
query_regex=$(printf "%s" "$query_regex" | sed -E "s/ +/([[:space:]]|$placeholder)+/g")

# Use bash variable substitution to insert the actual color regex
ESC=$(printf '\033')
actual_color_regex="${ESC}\\[[0-9;]*m"
query_regex="${query_regex//$placeholder/$actual_color_regex}"


# Build grep command
# -b: byte offset of each line, -h: no filename, --line-buffered: every match
# is written out as it is found. All three are portable across GNU and BSD.
grep_cmd=(grep -E -h -b --line-buffered)
if [ -n "$max_matches" ]; then
  grep_cmd+=(-m "$max_matches")   # -m = max count (portable)
fi

if [ -n "$file" ]; then
  exec "${grep_cmd[@]}" "$query_regex" "$file"
else
  exec "${grep_cmd[@]}" "$query_regex"
fi
