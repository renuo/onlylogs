#!/usr/bin/env bash
export LC_ALL=C

# Parse arguments
max_matches=""
start_position=""
end_position=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --max-matches)
      max_matches="$2"
      shift 2
      ;;
    --start-position)
      start_position="$2"
      shift 2
      ;;
    --end-position)
      end_position="$2"
      shift 2
      ;;
    --regexp)
      regexp_mode=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

query="$1"
file="$2"

# Validate file
[ -f "$file" ] || exit 1

# Prepare query regex based on mode
if [ "$regexp_mode" = true ]; then
  # Translate \d to [0-9] for consistency
  query_regex=$(printf "%s" "$query" | sed 's/\\d/[0-9]/g')
else
  # Escape special characters
  query_regex=$(printf "%s" "$query" | sed -E 's/([][{}()*+?.\\^$|])/\\\1/g')
fi

# Replace spaces with placeholder to avoid sed escaping hell for color regex
placeholder="__COLOR_REGEX__"
query_regex=$(printf "%s" "$query_regex" | sed -E "s/ +/([[:space:]]|$placeholder)+/g")

# Use bash variable substitution to insert the actual color regex
# Ripgrep supports \x1b directly
actual_color_regex='\x1b\[[0-9;]*m'
query_regex="${query_regex//$placeholder/$actual_color_regex}"

# Build ripgrep command
# --no-mmap: read the file with read() instead of memory-mapping it. mmap'ing a
# multi-GB log file maps the whole file into the process and, in a container,
# charges those pages to the cgroup as active memory, which can trigger an OOM
# kill. Plain read() pages are ordinary, readily-reclaimable page cache.
# --byte-offset: include byte offset in output for the logs-around-line feature
rg_cmd="rg --color=never --no-filename --byte-offset --no-mmap"
[ -n "$max_matches" ] && rg_cmd="$rg_cmd --max-count=$max_matches"

# Handle byte range if specified
if [ -n "$start_position" ] || [ -n "$end_position" ]; then
  case "${start_position:-0}${end_position:-0}" in
    *[!0-9]*) exit 1 ;;
  esac

  file_size=$(wc -c < "$file")
  range_start=${start_position:-0}
  range_end=${end_position:-$file_size}
  range_size=$((range_end - range_start))

  if [ $range_size -le 0 ] || [ $range_start -ge $file_size ]; then
    exit 0
  fi

  [ $range_end -gt $file_size ] && range_end=$file_size && range_size=$((range_end - range_start))

  block_bytes=1048576
  start_block=$((range_start / block_bytes))
  start_offset=$((range_start % block_bytes))
  count_blocks=$(((start_offset + range_size + block_bytes - 1) / block_bytes))

  # tail and head trim the block-aligned read down to the exact window. `dd
  # bs=1` did that with one read() and one write() per byte, which capped the
  # whole search at 1.5 MB/s while pinning a core.
  dd if="$file" bs=$block_bytes skip=$start_block count=$count_blocks 2>/dev/null | \
    tail -c +$((start_offset + 1)) | head -c $range_size | \
    $rg_cmd -e "$query_regex"
else
  # Search entire file
  $rg_cmd -e "$query_regex" "$file"
fi
